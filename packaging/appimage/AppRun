#!/bin/sh
# Carnage Heart Recompiled: AppImage entry point (Steam Deck and other Linux).
#
# The AppImage holds the Linux setup kit (launcher + setup wizard + project
# sources + recompiler, no game code). An AppImage is read-only, but the kit
# builds the game from the player's disc into its own folder, so the first
# start copies the kit into a normal folder and runs it from there:
#
#   <folder of the AppImage>/CarnageHeart/      (or ~/Games/CarnageHeart when
#                                                that folder can't be written;
#                                                CH_GAME_DIR overrides both)
#
# Later starts run straight from that folder. A newer AppImage copies its
# newer kit over the old one (the player's settings, saves, memory cards and
# disc are kept); an older AppImage never replaces a newer kit, so updates
# made from the launcher's UPDATE page stay.
#
# The disc: put the Carnage Heart (USA) .cue and its .bin files beside the
# AppImage (or in CarnageHeart/disc/). Files beside the AppImage are linked
# into CarnageHeart/disc/, where the setup wizard finds them.
#
# CH_APPIMAGE_INSTALL_ONLY=1 copies and links, prints the folder and exits
# (used by CI).
set -eu

HERE="$(dirname "$(readlink -f "$0")")"
KIT="$HERE/usr/share/carnageheart/kit"
EXE_NAME="CarnageHeart_Recompiled"
SELF="${APPIMAGE:-$HERE}"
BESIDE="$(dirname "$SELF")"

say() { printf 'Carnage Heart: %s\n' "$*" >&2; }

can_write() {
    mkdir -p "$1" 2>/dev/null && [ -w "$1" ]
}

GAME="${CH_GAME_DIR:-}"
if [ -z "$GAME" ]; then
    GAME="$BESIDE/CarnageHeart"
    can_write "$GAME" || GAME="${HOME:-/tmp}/Games/CarnageHeart"
fi
can_write "$GAME" || { say "can't write to $GAME (set CH_GAME_DIR)"; exit 1; }

read_ver() { if [ -f "$1" ]; then tr -d '[:space:]' < "$1"; fi; }
kit_ver="$(read_ver "$KIT/VERSION")"; kit_ver="${kit_ver:-0}"
have_ver="$(read_ver "$GAME/VERSION")"

# Newer = sorts last with sort -V and differs.
newer() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# Files the player owns: kept when a newer kit is copied over.
KEEP="disc.cfg bios.cfg rom.cfg launcher.ini launcher-window.ini config.ini
settings.toml keybinds.ini input.ini overlay_captures.json"

install_kit() {
    say "installing version $kit_ver into $GAME"
    keep="$GAME/.ch-keep"
    rm -rf "$keep"; mkdir -p "$keep"
    for f in $KEEP; do if [ -f "$GAME/$f" ]; then cp -p "$GAME/$f" "$keep/$f"; fi; done
    # cp without -p: copied files get the current time, so the game's build
    # never takes them for already compiled.
    cp -R "$KIT/." "$GAME/"
    for f in $KEEP; do if [ -f "$keep/$f" ]; then cp -p "$keep/$f" "$GAME/$f"; fi; done
    rm -rf "$keep"
    chmod +x "$GAME/$EXE_NAME" 2>/dev/null || true
    if [ -n "$have_ver" ]; then
        # An older install: make the game again from the disc with the new
        # recompiler (the setup exe does that when generated/ is missing).
        rm -rf "$GAME/generated"
    fi
    printf 'appimage %s\n' "$kit_ver" > "$GAME/.installed-from"
}

if [ ! -x "$GAME/$EXE_NAME" ] || [ -z "$have_ver" ] || newer "$kit_ver" "$have_ver"; then
    install_kit
fi

# Link a disc found beside the AppImage into disc/, unless one is there.
link_disc() {
    ls "$GAME"/disc/*.cue >/dev/null 2>&1 && return 0
    ls "$GAME"/*.cue >/dev/null 2>&1 && return 0
    for cue in "$BESIDE"/*.cue; do
        [ -f "$cue" ] || continue
        case "$(basename "$cue")" in *[Cc]arnage*) ;; *) continue ;; esac
        mkdir -p "$GAME/disc"
        ln -sf "$cue" "$GAME/disc/$(basename "$cue")"
        # Every track the .cue names (FILE "name" BINARY).
        sed -n 's/^[[:space:]]*FILE[[:space:]]*"\(.*\)".*/\1/p' "$cue" | tr -d '\r' |
        while IFS= read -r track; do
            if [ -f "$BESIDE/$track" ]; then ln -sf "$BESIDE/$track" "$GAME/disc/$track"; fi
        done
        say "using the disc beside the AppImage: $(basename "$cue")"
        return 0
    done
    return 0
}
link_disc

if [ "${CH_APPIMAGE_INSTALL_ONLY:-0}" = 1 ]; then
    printf '%s\n' "$GAME"
    exit 0
fi

cd "$GAME"
exec "./$EXE_NAME" "$@"
