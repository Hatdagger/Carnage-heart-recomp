<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for "it's your turn" notifications. Android draws small
     icons as a single-colour mask (only the alpha channel counts), so this is
     a plain white shape: a map hex with a unit marker in the middle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Hex outline (pointy top), 2 units thick. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,1.5 L21.1,6.75 L21.1,17.25 L12,22.5 L2.9,17.25 L2.9,6.75 Z
                          M12,3.8 L4.9,7.9 L4.9,16.1 L12,20.2 L19.1,16.1 L19.1,7.9 Z" />
    <!-- Unit marker: a solid diamond. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7.5 L16.5,12 L12,16.5 L7.5,12 Z" />
</vector>
